# ==========================================
# .env.server.example — Trainer Pro
# Copie para .env.server e preencha os valores
# NUNCA commite o .env.server com valores reais
# ==========================================

# Senha do PostgreSQL (gere uma senha forte)
DB_PASSWORD=SUA_SENHA_FORTE_AQUI

# Secret para cookies de sessão (mínimo 32 caracteres aleatórios)
# Gere com: openssl rand -hex 32
NEXTAUTH_SECRET=SEU_SECRET_AQUI

# URL pública do app (sem barra no final)
APP_URL=https://trainer.seudominio.com.br
